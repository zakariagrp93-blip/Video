{
  "name": "finance-video-studio",
  "productName": "Finance Video Studio",
  "version": "1.0.0",
  "description": "AI-powered desktop factory for minimalist finance storytelling TikTok videos.",
  "author": "Finance Video Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env FVS_DEV_URL=http://localhost:5173 electron .\"",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main && npm run build:remotion",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:remotion": "node scripts/bundle-remotion.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "start": "electron .",
    "dist:win": "npm run build && node scripts/prepare-win.mjs && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@remotion/renderer": "^4.0.542",
    "espeak-ng": "^1.0.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.31.1",
    "openai": "^7.54.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "sql.js": "^1.15.2",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@remotion/bundler": "^4.0.542",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
